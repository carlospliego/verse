<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!--
      No network entitlements, deliberately. The app makes no network calls at all,
      and the absence of com.apple.security.network.client means the sandbox would
      refuse one even if a future change tried.
    -->
</dict>
</plist>
